   "source": [
    "# gnn_joint_conditional_demo.py\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "\n",
    "# --------------------------\n",
    "# Config (adjust as you like)\n",
    "# --------------------------\n",
    "SEED         = 0\n",
    "K            = 5               # number of variables (nodes)\n",
    "MASK_IDX     = (1, 2)          # we will predict x_2 and x_3 (0-based)\n",
    "HIDDEN       = 64              # hidden width\n",
    "LAYERS       = 20              # <-- increase/decrease GNN depth here\n",
    "RESIDUAL     = True\n",
    "DROPOUT      = 0.10\n",
    "LR           = 2e-3\n",
    "EPOCHS       = 30              # increase for tighter fit\n",
    "BATCH_SIZE   = 256\n",
    "N_TRAIN      = 4000\n",
    "N_VAL        = 800\n",
    "N_TEST       = 800\n",
    "QUICK        = False           # set True for a very fast sanity run\n",
    "\n",
    "torch.manual_seed(SEED); np.random.seed(SEED)\n",
    "device = \"cpu\"\n",
    "\n",
    "# --------------------------\n",
    "# Graph utilities\n",
    "# --------------------------\n",
    "def build_chain_graph(k=5):\n",
    "    A = np.zeros((k, k), dtype=float)\n",
    "    edges = []\n",
    "    for i in range(k-1):\n",
    "        A[i, i+1] = A[i+1, i] = 1.0\n",
    "        edges.append((i, i+1))\n",
    "    # normalized adjacency with self loops for stable message passing\n",
    "    I = np.eye(k)\n",
    "    A_tilde = A + I\n",
    "    D_inv = np.diag(1.0 / A_tilde.sum(axis=1))\n",
    "    A_norm = D_inv @ A_tilde\n",
    "    return A, edges, A_norm\n",
    "\n",
    "def make_precision_from_graph(A, seed=0):\n",
    "    rng = np.random.default_rng(seed)\n",
    "    k = A.shape[0]\n",
    "    W = np.zeros_like(A, dtype=float)\n",
    "    for i in range(k):\n",
    "        for j in range(i+1, k):\n",
    "            if A[i, j] == 1:\n",
    "                # attractive GMRF-like coupling\n",
    "                val = -0.3 - 0.2 * rng.random()\n",
    "                W[i, j] = W[j, i] = val\n",
    "    diag = np.abs(W).sum(axis=1) + 1.0  # strictly diagonally dominant\n",
    "    K = W.copy()\n",
    "    np.fill_diagonal(K, diag)\n",
    "    # ensure PD\n",
    "    eigmin = np.linalg.eigvalsh(K).min()\n",
    "    if eigmin <= 1e-9:\n",
    "        K += (1e-8 - eigmin) * np.eye(k)\n",
    "    return K\n",
    "\n",
    "# --------------------------\n",
    "# Model (GNN + bivariate head)\n",
    "# --------------------------\n",
    "class BivariateReadout(nn.Module):\n",
    "    \"\"\"\n",
    "    Maps a vector (concat of masked nodes' embeddings) -> (mu in R^2, PD covariance via Cholesky).\n",
    "    L = [[a, 0], [b, c]], with a>0, c>0.  Sigma = L L^T.\n",
    "    \"\"\"\n",
    "    def __init__(self, in_dim, hidden=64):\n",
    "        super().__init__()\n",
    "        self.net_mu  = nn.Sequential(nn.Linear(in_dim, hidden), nn.ReLU(), nn.Linear(hidden, 2))\n",
    "        self.net_tri = nn.Sequential(nn.Linear(in_dim, hidden), nn.ReLU(), nn.Linear(hidden, 3))\n",
    "\n",
    "    def forward(self, h_flat):\n",
    "        mu = self.net_mu(h_flat)       # (B,2)\n",
    "        raw = self.net_tri(h_flat)     # (B,3)\n",
    "        a = torch.nn.functional.softplus(raw[:, 0]) + 1e-6\n",
    "        b = raw[:, 1]\n",
    "        c = torch.nn.functional.softplus(raw[:, 2]) + 1e-6\n",
    "        return mu, a, b, c\n",
    "\n",
    "def nll_bivariate(y, mu, a, b, c):\n",
    "    \"\"\"\n",
    "    y:  (B,2), mu: (B,2), a>0, c>0, b: R\n",
    "    L = [[a, 0], [b, c]],  Σ = L L^T.\n",
    "    NLL = 0.5 * [ (y-mu)^T Σ^{-1} (y-mu) + log|Σ| + 2 log(2π) ].\n",
    "    \"\"\"\n",
    "    zx = y - mu\n",
    "    u1 = zx[:, 0] / a\n",
    "    u2 = (zx[:, 1] - b * u1) / c\n",
    "    quad = u1**2 + u2**2\n",
    "    logdet = 2.0 * (torch.log(a) + torch.log(c))\n",
    "    return 0.5 * (quad + logdet + 2.0 * torch.log(torch.tensor(2.0 * torch.pi)))\n",
    "\n",
    "class DeepMaskedGNNJoint(nn.Module):\n",
    "    \"\"\"\n",
    "    Deeper GNN that:\n",
    "      - takes per-node features [value_z, mask_bit]\n",
    "      - runs L layers of adjacency-masked message passing (GCN-style)\n",
    "      - gathers only MASKED nodes' embeddings and predicts joint N(μ, Σ) in R^2\n",
    "    \"\"\"\n",
    "    def __init__(self, A_norm, k, mask_idx=(1,2), hidden=64, L=4, residual=True, dropout=0.0):\n",
    "        super().__init__()\n",
    "        self.A = torch.tensor(A_norm, dtype=torch.float32)\n",
    "        self.k = k\n",
    "        self.mask_idx = torch.tensor(mask_idx, dtype=torch.long)\n",
    "        self.L = L\n",
    "        self.residual = residual\n",
    "        self.dropout = nn.Dropout(dropout) if dropout > 0 else nn.Identity()\n",
    "\n",
    "        self.fc_in = nn.Linear(2, hidden)\n",
    "        self.layers = nn.ModuleList([nn.Linear(hidden, hidden) for _ in range(L)])\n",
    "        self.norms  = nn.ModuleList([nn.LayerNorm(hidden) for _ in range(L)])\n",
    "        self.act = nn.ReLU()\n",
    "\n",
    "        read_dim = hidden * len(mask_idx)     # concat embeddings of masked nodes\n",
    "        self.readout = BivariateReadout(read_dim, hidden=hidden)\n",
    "\n",
    "    def message(self, H):\n",
    "        # H: (B,k,d); A: (k,k) -> (B,k,d)\n",
    "        return torch.einsum('ij,bjd->bid', self.A, H)\n",
    "\n",
    "    def forward(self, x, mask_bits):\n",
    "        # x, mask_bits: (B,k)\n",
    "        Xf = torch.stack([x, mask_bits], dim=-1)   # (B,k,2)\n",
    "        H  = self.act(self.fc_in(Xf))              # (B,k,h)\n",
    "        for l in range(self.L):\n",
    "            H_in = H\n",
    "            H = self.message(H)\n",
    "            H = self.layers[l](H)\n",
    "            H = self.act(H)\n",
    "            H = self.dropout(H)\n",
    "            H = self.norms[l](H)\n",
    "            if self.residual:\n",
    "                H = H + H_in\n",
    "        # gather only masked nodes\n",
    "        H_mask = H[:, self.mask_idx, :]           # (B, |M|, h)\n",
    "        H_flat = H_mask.reshape(H_mask.shape[0], -1)  # (B, |M|*h)\n",
    "        mu, a, b, c = self.readout(H_flat)        # μ in R^2; L params\n",
    "        return mu, a, b, c\n",
    "\n",
    "# --------------------------\n",
    "# Build graph, covariance, data\n",
    "# --------------------------\n",
    "A, edges, A_norm = build_chain_graph(K)\n",
    "print(\"=== Graph info ===\")\n",
    "print(\"Nodes:\", list(range(1, K+1)))\n",
    "print(\"Edges (1-based):\", [(i+1, j+1) for (i,j) in edges])\n",
    "print(\"Adjacency matrix (0/1):\")\n",
    "print(np.array(A, dtype=int))\n",
    "\n",
    "Kmat = make_precision_from_graph(A, seed=SEED)\n",
    "Sigma = np.linalg.inv(Kmat)\n",
    "mu_true = np.linspace(-1.0, 1.0, K)\n",
    "\n",
    "print(\"\\n=== True covariance Σ (rounded 3dp) ===\")\n",
    "print(np.round(Sigma, 3))\n",
    "\n",
    "# Dataset sizes\n",
    "if QUICK:\n",
    "    N_TRAIN, N_VAL, N_TEST = 1500, 300, 300\n",
    "    EPOCHS = 12\n",
    "    HIDDEN = 32\n",
    "    LAYERS = max(2, min(LAYERS, 24))\n",
    "\n",
    "X_all = np.random.multivariate_normal(mu_true, Sigma, size=N_TRAIN + N_VAL + N_TEST)\n",
    "X_train = torch.tensor(X_all[:N_TRAIN], dtype=torch.float32)\n",
    "X_val   = torch.tensor(X_all[N_TRAIN:N_TRAIN+N_VAL], dtype=torch.float32)\n",
    "X_test  = torch.tensor(X_all[N_TRAIN+N_VAL:], dtype=torch.float32)\n",
    "\n",
    "M = torch.tensor(MASK_IDX, dtype=torch.long)\n",
    "O = torch.tensor([i for i in range(K) if i not in MASK_IDX], dtype=torch.long)\n",
    "\n",
    "# z-score features\n",
    "x_mean = X_train.mean(0, keepdim=True)\n",
    "x_std  = X_train.std(0, keepdim=True).clamp_min(1e-6)\n",
    "def z(x): return (x - x_mean) / x_std\n",
    "def unscale_mean(mu, idx):\n",
    "    std = x_std[0, idx]; mean = x_mean[0, idx]\n",
    "    return mu*std + mean\n",
    "def unscale_cov(S, idx):\n",
    "    # S is 2x2 in z-space; convert back with diag(stds)*S*diag(stds)\n",
    "    stds = x_std[0, idx]\n",
    "    D = torch.diag(stds)\n",
    "    return D @ S @ D\n",
    "\n",
    "# True conditional blocks (torch)\n",
    "Sigma_t = torch.tensor(Sigma, dtype=torch.float32)\n",
    "mu_t    = torch.tensor(mu_true, dtype=torch.float32)\n",
    "S_MM = Sigma_t[np.ix_(M, M)]\n",
    "S_MO = Sigma_t[np.ix_(M, O)]\n",
    "S_OM = Sigma_t[np.ix_(O, M)]\n",
    "S_OO = Sigma_t[np.ix_(O, O)]\n",
    "S_OO_inv = torch.linalg.inv(S_OO)\n",
    "\n",
    "def true_conditional(x):\n",
    "    # x: (B, K) in original units\n",
    "    xO = x[:, O]\n",
    "    muM = mu_t[M] + (S_MO @ S_OO_inv @ (xO - mu_t[O]).T).T       # (B,2)\n",
    "    Scond = S_MM - S_MO @ S_OO_inv @ S_OM                        # (2,2) constant across x\n",
    "    return muM, Scond\n",
    "\n",
    "# --------------------------\n",
    "# Prepare batches\n",
    "# --------------------------\n",
    "mask_token = 0.0  # since inputs are z-scored\n",
    "def make_batch(X):\n",
    "    Xz = z(X)\n",
    "    mb = torch.zeros_like(Xz)\n",
    "    Xin = Xz.clone()\n",
    "    Xin[:, M] = mask_token\n",
    "    mb[:, M] = 1.0\n",
    "    y = Xz[:, M]            # (B,2) targets in z-space for masked vars\n",
    "    return Xin, mb, y\n",
    "\n",
    "# --------------------------\n",
    "# Train\n",
    "# --------------------------\n",
    "model = DeepMaskedGNNJoint(A_norm, K, mask_idx=MASK_IDX, hidden=HIDDEN, L=LAYERS, residual=RESIDUAL, dropout=DROPOUT)\n",
    "opt = optim.Adam(model.parameters(), lr=LR)\n",
    "\n",
    "Xv_in, Mv, yv = make_batch(X_val)\n",
    "\n",
    "for ep in range(1, EPOCHS+1):\n",
    "    idx = torch.randperm(N_TRAIN)\n",
    "    Xt = X_train[idx]\n",
    "    total = 0.0\n",
    "    for i in range(0, N_TRAIN, BATCH_SIZE):\n",
    "        Xb = Xt[i:i+BATCH_SIZE]\n",
    "        Xin, mb, y = make_batch(Xb)\n",
    "        mu, a, b, c = model(Xin, mb)        # μ∈R^2 and Cholesky params\n",
    "        loss = nll_bivariate(y, mu, a, b, c).mean()\n",
    "        opt.zero_grad(); loss.backward(); opt.step()\n",
    "        total += loss.item() * Xb.shape[0]\n",
    "    if ep in (1, max(2, EPOCHS//2), EPOCHS):\n",
    "        with torch.no_grad():\n",
    "            muv, av, bv, cv = model(Xv_in, Mv)\n",
    "            val = nll_bivariate(yv, muv, av, bv, cv).mean().item()\n",
    "        print(f\"Epoch {ep:2d} | train NLL {total/N_TRAIN:.4f} | val NLL {val:.4f}\")\n",
    "\n",
    "# --------------------------\n",
    "# Evaluate & print required outputs\n",
    "# --------------------------\n",
    "with torch.no_grad():\n",
    "    # Pick one test sample to display detailed numbers\n",
    "    x_demo = X_test[0:1]                           # (1,K), original units\n",
    "\n",
    "    # True conditional (original units)\n",
    "    mu_true_demo, Scond_true = true_conditional(x_demo)   # μ_true in original units; Scond_true in original units\n",
    "\n",
    "    # Model prediction for demo (need to unscale)\n",
    "    Xin, mb, _ = make_batch(x_demo)\n",
    "    mu_z, a, b, c = model(Xin, mb)                 # z-space μ; Cholesky is scale-free\n",
    "    # Covariance in z-space\n",
    "    L = torch.stack([torch.stack([a, torch.zeros_like(a)], dim=-1),\n",
    "                     torch.stack([b, c], dim=-1)], dim=1)[0]  # (2,2) for batch size 1\n",
    "    Sigma_z = L @ L.T                               # (2,2) in z space\n",
    "    # Unscale to original units\n",
    "    mu_pred_demo = unscale_mean(mu_z[0], M)         # (2,)\n",
    "    Sigma_pred_demo = unscale_cov(Sigma_z, M)       # (2,2)\n",
    "\n",
    "    # Also compute aggregate errors over test set\n",
    "    Xte_in, Mte, yte = make_batch(X_test)\n",
    "    mu_z_all, a_all, b_all, c_all = model(Xte_in, Mte)\n",
    "    # form per-sample Sigma_z (we only need diag RMSE so build diag directly)\n",
    "    var1_z = a_all**2\n",
    "    var2_z = (b_all**2 + c_all**2)\n",
    "    # unscale means and variances\n",
    "    mu_all = unscale_mean(mu_z_all, M)              # (N,2)\n",
    "    stds = x_std[0, M]\n",
    "    var_all = torch.stack([var1_z*stds[0]**2, var2_z*stds[1]**2], dim=-1)  # (N,2)\n",
    "    # true conditional for all tests\n",
    "    mu_true_all, Scond_true_all = true_conditional(X_test)\n",
    "    var_true_all = torch.tensor([Scond_true_all[0,0], Scond_true_all[1,1]]).unsqueeze(0).repeat(X_test.shape[0], 1)\n",
    "\n",
    "    rmse_mu = torch.sqrt(((mu_all - mu_true_all)**2).mean(dim=0))\n",
    "    rmse_var = torch.sqrt(((var_all - var_true_all)**2).mean(dim=0))\n",
    "\n",
    "# --------- PRINTS you asked for ----------\n",
    "print(\"\\n=== FINAL REPORT ===\")\n",
    "print(\"Masked variables (1-based):\", [i+1 for i in MASK_IDX])\n",
    "print(\"\\nTrue covariance Σ (again, rounded 3dp):\")\n",
    "print(np.round(Sigma, 3))\n",
    "\n",
    "print(\"\\n--- One-sample (test[0]) conditional ---\")\n",
    "print(\"Observed indices (1-based):\", [i+1 for i in O.tolist()])\n",
    "print(\"Observed values           :\", x_demo[0, O].numpy())\n",
    "\n",
    "print(\"\\nTrue conditional mean for [2,3]:\")\n",
    "print(mu_true_demo[0].numpy())\n",
    "print(\"True conditional covariance (2x2) for [2,3]:\")\n",
    "print(Scond_true.numpy())\n",
    "\n",
    "print(\"\\nEstimated (GNN) conditional mean for [2,3]:\")\n",
    "print(mu_pred_demo.numpy())\n",
    "print(\"Estimated (GNN) conditional covariance (2x2) for [2,3]:\")\n",
    "print(Sigma_pred_demo.numpy())\n",
    "\n",
    "print(\"\\n--- Aggregate test errors ---\")\n",
    "print(\"RMSE of conditional mean per node [2,3]:\", rmse_mu.numpy())\n",
    "print(\"RMSE of conditional variance per node [2,3]:\", rmse_var.numpy())\n"
   ]
  },
