   "source": [
    "# Rerun with numerically robust, non-negative computation of ||T||^2 via residual form\n",
    "#   T2 = (v - proj_u^A v)^T A (v - proj_u^A v)\n",
    "# and using Cholesky of A to ensure >= 0 up to machine precision.\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from numpy.random import default_rng\n",
    "\n",
    "rng = default_rng(123)\n",
    "\n",
    "# Parameters\n",
    "n = 10\n",
    "N_X = 60\n",
    "H_VALUES = list(range(0, 6))\n",
    "N_PERMS_PER_H = 120\n",
    "sigma2 = 5.0\n",
    "tau2 = 0.5\n",
    "phi_values = [0.1, 0.3, 0.5, 1.0, 2.0, 3.0, 5.0, 8.0, 12.0]\n",
    "\n",
    "# Distance matrix on 1D grid\n",
    "xloc = np.linspace(0.0, 1.0, n)\n",
    "D = np.abs(xloc[:, None] - xloc[None, :])\n",
    "\n",
    "def make_sigma_from_phi(phi, sigma2=5.0, tau2=0.5):\n",
    "    K = np.exp(-phi * D)\n",
    "    S = sigma2 * K + tau2 * np.eye(n)\n",
    "    return (S + S.T) / 2.0\n",
    "\n",
    "def random_perms_with_h_swaps(n, h, m, rng):\n",
    "    perms = np.tile(np.arange(n), (m, 1))\n",
    "    if h == 0:\n",
    "        return perms\n",
    "    for i in range(m):\n",
    "        perm = perms[i]\n",
    "        idx = rng.choice(n, size=2*h, replace=False)\n",
    "        rng.shuffle(idx)\n",
    "        for a, b in zip(idx[::2], idx[1::2]):\n",
    "            perm[a], perm[b] = perm[b], perm[a]\n",
    "    return perms\n",
    "\n",
    "def batch_T_norm_sq_nonneg(u, V, A, L):\n",
    "    # u: (n,), V: (m,n), A: (n,n), L: lower-triangular, A = L L^T\n",
    "    Au = A @ u\n",
    "    uTAu = float(u @ Au)\n",
    "    # projection coefficients for each v_i\n",
    "    uTAv = V @ Au           # shape (m,)\n",
    "    coef = uTAv / uTAu      # shape (m,)\n",
    "    R = V - np.outer(coef, u)     # residuals (m,n)\n",
    "    # T2_i = || R_i L ||^2 (row-wise), guarantees non-negativity\n",
    "    Z = R @ L\n",
    "    T2 = np.einsum('ij,ij->i', Z, Z)\n",
    "    # numerical floor\n",
    "    T2 = np.maximum(T2, 0.0)\n",
    "    return T2\n",
    "\n",
    "rows = []\n",
    "\n",
    "for phi in phi_values:\n",
    "    S = make_sigma_from_phi(phi, sigma2=sigma2, tau2=tau2)\n",
    "    # Inverse and condition (with slight jitter if needed)\n",
    "    try:\n",
    "        A = np.linalg.inv(S)\n",
    "    except np.linalg.LinAlgError:\n",
    "        S = S + 1e-10*np.eye(n)\n",
    "        A = np.linalg.inv(S)\n",
    "    # enforce symmetry\n",
    "    A = 0.5*(A + A.T)\n",
    "    # Cholesky of A (SPD expected)\n",
    "    try:\n",
    "        L = np.linalg.cholesky(A)\n",
    "    except np.linalg.LinAlgError:\n",
    "        # add tiny jitter to ensure SPD\n",
    "        A = A + 1e-12*np.eye(n)\n",
    "        L = np.linalg.cholesky(A)\n",
    "    kappa = float(np.linalg.cond(S))\n",
    "    for xi in range(N_X):\n",
    "        x1 = rng.standard_normal(n)\n",
    "        for h in H_VALUES:\n",
    "            perms = random_perms_with_h_swaps(n, h, N_PERMS_PER_H, rng)\n",
    "            V = x1[perms]\n",
    "            vals = batch_T_norm_sq_nonneg(x1, V, A, L)\n",
    "            rows.append({\n",
    "                \"phi\": phi,\n",
    "                \"kappa_Sigma\": kappa,\n",
    "                \"h\": h,\n",
    "                \"mean_T2_per_draw\": float(np.mean(vals)),\n",
    "                \"sd_T2_per_draw\": float(np.std(vals, ddof=1)),\n",
    "            })\n",
    "\n",
    "df = pd.DataFrame(rows)\n",
    "summary = df.groupby([\"phi\", \"kappa_Sigma\", \"h\"], as_index=False).agg(\n",
    "    mean_T2=(\"mean_T2_per_draw\", \"mean\"),\n",
    "    se_T2=(\"mean_T2_per_draw\", lambda x: x.std(ddof=1)/np.sqrt(len(x))),\n",
    "    avg_sd_within=(\"sd_T2_per_draw\", \"mean\"),\n",
    ")\n",
    "\n",
    "# Display table\n",
    "\n",
    "summary.sort_values([\"h\", \"phi\"])\n",
    "\n",
    "\n",
    "# Plots\n",
    "for h in sorted(summary[\"h\"].unique()):\n",
    "    sub = summary[summary[\"h\"] == h].sort_values(\"kappa_Sigma\")\n",
    "    plt.figure()\n",
    "    plt.plot(sub[\"kappa_Sigma\"], sub[\"mean_T2\"], marker=\"o\")\n",
    "    for _, row in sub.iterrows():\n",
    "        plt.annotate(f\"phi={row['phi']}\", (row[\"kappa_Sigma\"], row[\"mean_T2\"]), textcoords=\"offset points\", xytext=(5,5))\n",
    "    plt.title(f\"NON-NEGATIVE Average ||T||^2 vs κ(Σ) — h={h} (n={n})\")\n",
    "    plt.xlabel(\"κ(Σ)\")\n",
    "    plt.ylabel(\"Average ||T||^2\")\n",
    "    plt.grid(True)\n",
    "plt.show()\n"
   ]
  },
